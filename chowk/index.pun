<?pun
/*
  index.pun — the Pun landing page.
  This page is itself a Pun script: the greeting, the keyword table,
  the live results and the footer are all written by dasso.
*/

naam = mang.GET["naam"]

je naam == khali || naam == "" {
    naam = "Dost"
}

// One row of the keyword table.
kaam shabad(pun, gurmukhi, lafz, kamm) {
    wapas "<tr><td><code>" + pun + "</code></td><td class=\"pa\" lang=\"pa\">" + gurmukhi + "</td><td>" + lafz + "</td><td>" + kamm + "</td></tr>"
}

// Functions used by the live demo section.
kaam jod(a, b) {
    wapas a + b
}

kaam factorial(n) {
    je n <= 1 {
        wapas 1
    }
    wapas n * factorial(n - 1)
}
?>
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>PUNjabi Scripting Language</title>
<link rel="icon" type="image/png" href="/pun_logo.png">
<link rel="apple-touch-icon" href="/pun_logo.png">
<style>
:root {
    --bg: #fbf7f0;
    --surface: #ffffff;
    --ink: #1f1a17;
    --muted: #675e55;
    --line: #e6dccd;
    --kesri: #b4500a;
    --kesri-soft: #fdf0e3;
    --neela: #1e3a8a;
    --code-bg: #1c1917;
    --code-ink: #f5efe6;
    --code-k: #fdba74;
    --code-s: #86efac;
    --code-n: #93c5fd;
    --code-c: #a8a29e;
    --code-t: #f9a8d4;
    --phulkari-a: #7a1f2b;
    --phulkari-b: #e8a33d;
    --radius: 14px;
    --sans: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    --pa: "Noto Sans Gurmukhi", "Raavi", "Mukta Mahee", var(--sans);
    --mono: ui-monospace, "Cascadia Code", Consolas, "SF Mono", monospace;
}
@media (prefers-color-scheme: dark) {
    :root {
        --bg: #14110e;
        --surface: #1e1a16;
        --ink: #f3ece2;
        --muted: #aaa096;
        --line: #322b24;
        --kesri: #f59e4b;
        --kesri-soft: #2a1d12;
        --neela: #9db8ff;
        --code-bg: #0e0c0a;
    }
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font: 16px/1.6 var(--sans);
}
a { color: var(--neela); }
code, pre, .chip, .pipeline li, .ops dd, .file {
    font-family: var(--mono);
    /* show <=, >=, != as typed, not as ligature glyphs */
    font-variant-ligatures: none;
    font-feature-settings: "liga" 0, "calt" 0;
}
p code, li code, td code, dd code {
    font-size: .9em;
    background: var(--kesri-soft);
    color: var(--kesri);
    padding: .1em .35em;
    border-radius: 5px;
    white-space: nowrap;
}
.pa { font-family: var(--pa); }
.wrap { max-width: 1080px; margin: 0 auto; padding: 0 16px; }

/* Phulkari-inspired band */
.phulkari {
    height: 10px;
    background:
        conic-gradient(from 45deg, var(--phulkari-b) 25%, transparent 0 50%, var(--phulkari-b) 0 75%, transparent 0) 0 0 / 14px 14px,
        var(--phulkari-a);
}

header.top { border-bottom: 1px solid var(--line); }
header.top .wrap {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: 8px 24px; padding-top: 14px; padding-bottom: 14px;
}
.brand { font-weight: 800; font-size: 1.35rem; letter-spacing: -.02em; text-decoration: none; color: var(--ink); }
.brand span { color: var(--kesri); }
nav { display: flex; flex-wrap: wrap; gap: 4px 18px; }
nav a { color: var(--muted); text-decoration: none; font-size: .95rem; }
nav a:hover { color: var(--kesri); }

section { padding: 56px 0; border-bottom: 1px solid var(--line); }
section:last-of-type { border-bottom: 0; }
h1, h2, h3 { line-height: 1.2; letter-spacing: -.015em; margin: 0 0 .5em; }
h1 { font-size: clamp(2rem, 5vw, 3.1rem); }
h2 { font-size: clamp(1.5rem, 3vw, 2rem); }
h3 { font-size: 1.1rem; }
.eyebrow {
    display: inline-block; font-size: .8rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase;
    color: var(--kesri); margin-bottom: 12px;
}
.lede { font-size: 1.15rem; color: var(--muted); max-width: 46ch; }
.section-intro { color: var(--muted); max-width: 64ch; margin: 0 0 28px; }

/* Hero */
.hero { display: grid; grid-template-columns: 1.1fr 1fr; gap: 40px; align-items: center; }
.greeting {
    margin-top: 28px; padding: 18px 20px; background: var(--surface);
    border: 1px solid var(--line); border-left: 4px solid var(--kesri); border-radius: var(--radius);
}
.greeting .hello { font-size: 1.5rem; font-weight: 700; margin: 0; }
.greeting .hello .pa { color: var(--kesri); }
.greeting p { margin: 6px 0 12px; color: var(--muted); font-size: .92rem; }
form.naam { display: flex; flex-wrap: wrap; gap: 8px; }
form.naam input {
    flex: 1 1 160px; min-width: 0; padding: 9px 12px; font: inherit;
    border: 1px solid var(--line); border-radius: 9px; background: var(--bg); color: var(--ink);
}
form.naam button {
    padding: 9px 18px; font: inherit; font-weight: 600; cursor: pointer;
    border: 0; border-radius: 9px; background: var(--kesri); color: #fff;
}
@media (prefers-color-scheme: dark) { form.naam button { color: #1a1008; } }

/* Code blocks */
pre.code {
    margin: 0; padding: 18px 20px; overflow-x: auto;
    background: var(--code-bg); color: var(--code-ink);
    border-radius: var(--radius); font-size: .88rem; line-height: 1.65;
}
.file {
    display: flex; justify-content: space-between; align-items: center;
    background: var(--code-bg); color: var(--code-c); font: .78rem var(--mono);
    padding: 10px 20px 0; border-radius: var(--radius) var(--radius) 0 0;
}
.file + pre.code { border-radius: 0 0 var(--radius) var(--radius); }
.k { color: var(--code-k); font-weight: 600; }
.s { color: var(--code-s); }
.n { color: var(--code-n); }
.c { color: var(--code-c); font-style: italic; }
.t { color: var(--code-t); }

/* Render pipeline */
.pipeline { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin: 0 0 28px; padding: 0; list-style: none; }
.pipeline li {
    padding: 6px 12px; border-radius: 999px; font: .85rem var(--mono);
    background: var(--surface); border: 1px solid var(--line);
}
.pipeline li.arrow { border: 0; background: none; padding: 0; color: var(--muted); }
.facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 16px; }
.fact { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 18px; }
.fact h3 { margin-bottom: 6px; }
.fact p { margin: 0; color: var(--muted); font-size: .95rem; }

/* Keyword table */
.table-scroll { overflow-x: auto; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
table { width: 100%; border-collapse: collapse; min-width: 560px; }
th, td { text-align: left; padding: 11px 16px; border-bottom: 1px solid var(--line); vertical-align: top; }
tr:last-child td { border-bottom: 0; }
th { font-size: .78rem; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); font-weight: 600; }
td.pa { font-size: 1.1rem; }
tr.group td {
    background: var(--kesri-soft); color: var(--kesri); font-weight: 600; font-size: .8rem;
    text-transform: uppercase; letter-spacing: .06em; padding-top: 8px; padding-bottom: 8px;
}
.reserved { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 18px; color: var(--muted); font-size: .95rem; }
.chip {
    font: .85rem var(--mono); padding: 4px 10px; border-radius: 999px;
    border: 1px dashed var(--line); color: var(--ink); background: var(--surface);
}
.chip .pa { font-family: var(--pa); color: var(--muted); margin-left: 4px; }

/* Language tour */
.tour { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; }
.tour article { display: flex; flex-direction: column; }
.tour article p { color: var(--muted); margin: 0 0 12px; font-size: .95rem; flex: 1; }
.ops { margin: 28px 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px 24px; }
.ops div { border-top: 2px solid var(--kesri); padding-top: 10px; }
.ops dt { font-weight: 600; font-size: .9rem; }
.ops dd { margin: 4px 0 0; font-family: var(--mono); font-size: .92rem; color: var(--muted); word-spacing: .3em; }

/* Live demo */
.live { display: grid; gap: 12px; }
.live-row {
    display: grid; grid-template-columns: 1fr 220px; gap: 0;
    border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: var(--surface);
}
.live-row pre.code { border-radius: 0; padding: 12px 18px; }
.live-row .out { padding: 12px 18px; display: flex; flex-direction: column; justify-content: center; }
.live-row .out small { color: var(--muted); font-size: .72rem; text-transform: uppercase; letter-spacing: .06em; }
.live-row .out b { font: 600 1.15rem var(--mono); color: var(--kesri); }
.loop span {
    display: inline-block; min-width: 1.6em; text-align: center; margin-right: 3px;
    border-radius: 6px; background: var(--kesri-soft);
}

/* Sample site */
.sample-links { display: flex; flex-wrap: wrap; gap: 10px; margin: 0 0 28px; }
.sample-links a {
    padding: 9px 16px; border-radius: 9px; border: 1px solid var(--line); background: var(--surface);
    color: var(--ink); text-decoration: none; font-weight: 600;
}
.sample-links a:hover { border-color: var(--kesri); }
.sample-links a.primary { background: var(--kesri); border-color: var(--kesri); color: #fff; }
@media (prefers-color-scheme: dark) { .sample-links a.primary { color: #1a1008; } }
.fact h3 code { color: var(--kesri); }
.sample-files { margin-bottom: 28px; }
.sample-code { grid-template-columns: 1fr; gap: 28px; }
.sample-code article { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2.2fr); gap: 4px 28px; }
.sample-code .snippet { min-width: 0; }
@media (max-width: 820px) {
    .sample-code article { grid-template-columns: minmax(0, 1fr); }
}

/* Docs */
.docs { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 20px; }
.doc {
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius);
    padding: 22px; display: flex; flex-direction: column;
}
.doc .tag {
    align-self: flex-start; font-size: .72rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase;
    padding: 3px 9px; border-radius: 999px; background: var(--kesri-soft); color: var(--kesri); margin-bottom: 12px;
}
.doc .tag.plan { background: transparent; border: 1px dashed var(--muted); color: var(--muted); }
.doc h3 { margin-bottom: 4px; }
.doc .path { font: .85rem var(--mono); color: var(--neela); margin: 0 0 12px; word-break: break-all; }
.doc p { margin: 0 0 12px; color: var(--muted); font-size: .95rem; }
.doc ul { margin: auto 0 0; padding-left: 18px; font-size: .9rem; }
.doc li { margin: 2px 0; }
.docs-note { margin-top: 20px; color: var(--muted); font-size: .92rem; }

/* Run */
.run { display: grid; grid-template-columns: 1.3fr 1fr; gap: 28px; align-items: start; }
.run > * { min-width: 0; }
.run ul { margin: 0; padding-left: 18px; color: var(--muted); }
.run li { margin: 6px 0; }
.limits { margin-top: 28px; padding: 18px 20px; border-radius: var(--radius); border: 1px dashed var(--line); }
.limits h3 { margin-bottom: 6px; }
.limits p { margin: 0; color: var(--muted); font-size: .95rem; }

footer { padding: 28px 0 40px; color: var(--muted); font-size: .88rem; }
footer .wrap { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; }

@media (max-width: 820px) {
    .hero, .run { grid-template-columns: 1fr; }
    section { padding: 40px 0; }
}
@media (max-width: 520px) {
    .live-row { grid-template-columns: 1fr; }
}
</style>
</head>
<body>

<div class="phulkari" aria-hidden="true"></div>

<header class="top">
    <div class="wrap">
        <a class="brand" href="/">Pun<span>.</span></a>
        <nav aria-label="Sections">
            <a href="#bhasha">How it works</a>
            <a href="#shabad">Keywords</a>
            <a href="#tour">Language tour</a>
            <a href="#live">Live demo</a>
            <a href="#sample">Sample site</a>
            <a href="#docs">Docs</a>
            <a href="#chalao">Run it</a>
        </nav>
    </div>
</header>

<main>

<section>
    <div class="wrap hero">
        <div>
            <span class="eyebrow">Pun 1.0.0 &middot; Oye Chal Peya</span>
            <h1>Backend scripting that speaks Punjabi.</h1>
            <p class="lede">
                Pun is a small, PHP-style server-side language. Write ordinary HTML, drop in
                <code>&lt;?pun &hellip; ?&gt;</code> blocks using keywords like <code>je</code>,
                <code>kaam</code> and <code>dasso</code>, and Pun Server sends back the rendered page.
            </p>

            <div class="greeting">
                <p class="hello"><span class="pa" lang="pa">ਸਤ ਸ੍ਰੀ ਅਕਾਲ</span>, <?pun dasso naam ?>!</p>
                <p>That line was written by <code>dasso</code> on the server just now, using <code>mang.GET["naam"]</code>. Try your own name:</p>
                <form class="naam" method="GET" action="/">
                    <input name="naam" placeholder="Tuhada naam" aria-label="Your name" autocomplete="given-name">
                    <button type="submit">Dasso</button>
                </form>
            </div>
        </div>

        <div>
            <div class="file"><span>hello.pun</span><span>HTML + Pun</span></div>
<pre class="code"><span class="t">&lt;h1&gt;</span>Hello<span class="t">&lt;/h1&gt;</span>

<span class="t">&lt;?pun</span>
naam = mang.GET[<span class="s">"naam"</span>]

<span class="k">je</span> naam == <span class="k">khali</span> {
    naam = <span class="s">"Dost"</span>
}

<span class="k">dasso</span> <span class="s">"&lt;p&gt;Sat Sri Akal "</span> + naam + <span class="s">"&lt;/p&gt;"</span>
<span class="t">?&gt;</span></pre>
        </div>
    </div>
</section>

<section id="bhasha">
    <div class="wrap">
        <span class="eyebrow">How it works</span>
        <h2>One request, one rendered page</h2>
        <p class="section-intro">
            Pun has its own lexer, parser and interpreter, all in Java. It does not translate Pun to Java and it does not use an external scripting engine.
            When a browser asks for a <code>.pun</code> file, the request goes through these steps:
        </p>
        <ol class="pipeline" aria-label="Request pipeline">
            <li>RequestHandler</li><li class="arrow" aria-hidden="true">&rarr;</li>
            <li>PunTemplateEngine</li><li class="arrow" aria-hidden="true">&rarr;</li>
            <li>Lexer</li><li class="arrow" aria-hidden="true">&rarr;</li>
            <li>Parser</li><li class="arrow" aria-hidden="true">&rarr;</li>
            <li>AST</li><li class="arrow" aria-hidden="true">&rarr;</li>
            <li>Interpreter</li><li class="arrow" aria-hidden="true">&rarr;</li>
            <li>HTML response</li>
        </ol>
        <div class="facts">
            <div class="fact">
                <h3>HTML passes straight through</h3>
                <p>Anything outside <code>&lt;?pun &hellip; ?&gt;</code> is copied to the response as-is. Each block is replaced by whatever it <code>dasso</code>s.</p>
            </div>
            <div class="fact">
                <h3>Blocks share one page</h3>
                <p>Every block in a page shares the same environment. Set a variable at the top and use it further down. Blocks and functions create child scopes.</p>
            </div>
            <div class="fact">
                <h3>Source stays on the server</h3>
                <p>The browser only gets the rendered HTML. If a page has an error, you get a development error page with the file, line and message, never a Java stack trace.</p>
            </div>
            <div class="fact">
                <h3>Sandboxed by design</h3>
                <p>Scripts get no reflection, JVM classes, process execution, filesystem, environment variables or <code>System.exit</code>. Only <code>mang</code> and <code>jawab</code> are exposed.</p>
            </div>
        </div>
    </div>
</section>

<section id="shabad">
    <div class="wrap">
        <span class="eyebrow">Shabad &middot; keywords</span>
        <h2>Eleven keywords, two built-in objects, three collections and a database</h2>
        <p class="section-intro">Each keyword is an everyday Punjabi word chosen for what it does. This table is generated by a Pun function, <code>shabad()</code>, at the top of this page.</p>

        <div class="table-scroll">
            <table>
                <thead>
                    <tr><th>Pun</th><th>Gurmukhi</th><th>The word means</th><th>What it does in Pun</th></tr>
                </thead>
                <tbody>
                    <tr class="group"><td colspan="4">Control flow</td></tr>
<?pun
dasso shabad("je", "ਜੇ", "if", "Starts a condition: <code>je umar &gt;= 18 { &hellip; }</code>")
dasso shabad("nahi_ta", "ਨਹੀਂ ਤਾਂ", "otherwise", "The else branch after a <code>je</code> block")
dasso shabad("jad_tak", "ਜਦ ਤੱਕ", "as long as", "While loop: <code>jad_tak i &lt;= 5 { &hellip; }</code>")
dasso shabad("har_ik", "ਹਰ ਇੱਕ", "each one", "Loops over a collection: <code>har_ik dish vich menu { &hellip; }</code>")
dasso shabad("vich", "ਵਿੱਚ", "in", "Names the collection a <code>har_ik</code> loop walks through")
?>
                    <tr class="group"><td colspan="4">Functions &amp; output</td></tr>
<?pun
dasso shabad("kaam", "ਕੰਮ", "work, task", "Defines a function: <code>kaam jod(a, b) { &hellip; }</code>")
dasso shabad("wapas", "ਵਾਪਸ", "back", "Returns a value from a function")
dasso shabad("dasso", "ਦੱਸੋ", "tell", "Prints into the page, like <code>echo</code>")
?>
                    <tr class="group"><td colspan="4">Values</td></tr>
<?pun
dasso shabad("sach", "ਸੱਚ", "truth", "Boolean <code>true</code>")
dasso shabad("jhooth", "ਝੂਠ", "lie", "Boolean <code>false</code>")
dasso shabad("khali", "ਖ਼ਾਲੀ", "empty", "<code>null</code>, also returned for a missing query value")
?>
                    <tr class="group"><td colspan="4">Built-in objects</td></tr>
<?pun
dasso shabad("mang", "ਮੰਗ", "request, demand", "The HTTP request: <code>mang.GET</code>, <code>mang.POST</code>, <code>mang.method</code>, <code>mang.path</code>")
dasso shabad("jawab", "ਜਵਾਬ", "answer", "The HTTP response: <code>jawab.status</code>, <code>jawab.type</code>")
?>
                    <tr class="group"><td colspan="4">Collections</td></tr>
<?pun
dasso shabad("soochi", "ਸੂਚੀ", "list", "An ordered list: <code>soochi(\"Dal\", \"Roti\")</code>, read with <code>[0]</code>")
dasso shabad("shabdkosh", "ਸ਼ਬਦਕੋਸ਼", "dictionary", "Text keys to values: <code>shabdkosh(\"dal\": 240)</code>")
dasso shabad("jatha", "ਜੱਥਾ", "group, band", "A set that keeps each value once: <code>jatha(\"veg\", \"veg\")</code>")
?>
                    <tr class="group"><td colspan="4">Database</td></tr>
<?pun
dasso shabad("bhandar", "ਭੰਡਾਰ", "storehouse", "A MySQL connection: <code>bhandar(\"mysql\", host, port, db, user, pass)</code>, then <code>jodo()</code>, <code>taiyar(sql)</code>, <code>band()</code>")
?>
                </tbody>
            </table>
        </div>

        <div class="reserved">
            <span>Reserved for a later version:</span>
            <span class="chip">nava<span class="pa" lang="pa">ਨਵਾਂ</span></span>
        </div>
    </div>
</section>

<section id="tour">
    <div class="wrap">
        <span class="eyebrow">Language tour</span>
        <h2>The whole language in six snippets</h2>
        <p class="section-intro">Pun has numbers, strings, booleans and null, plus three collections (<code>soochi</code>, <code>shabdkosh</code>, <code>jatha</code>) and the usual operators. Braces mark blocks and semicolons are optional. The <a href="#sample">sample site</a> shows the collections in use.</p>

        <div class="tour">
            <article>
                <h3>Variables</h3>
                <p>No declaration keyword. Just assign.</p>
<pre class="code">naam   = <span class="s">"Suneet"</span>
umar   = <span class="n">37</span>
price  = <span class="n">99.95</span>
active = <span class="k">sach</span>
value  = <span class="k">khali</span></pre>
            </article>

            <article>
                <h3><code>dasso</code> prints</h3>
                <p>Output goes into the page exactly where the block sits. <code>+</code> joins strings, and numbers are turned into text.</p>
<pre class="code"><span class="k">dasso</span> <span class="s">"Hello "</span> + naam
<span class="k">dasso</span> <span class="s">"Total: "</span> + <span class="n">30</span>  <span class="c">// Total: 30</span>
<span class="k">dasso</span> <span class="n">10</span> + <span class="n">20</span> * <span class="n">2</span>      <span class="c">// 50</span></pre>
            </article>

            <article>
                <h3><code>je</code> / <code>nahi_ta</code></h3>
                <p>If and else. Conditions can be nested.</p>
<pre class="code"><span class="k">je</span> umar &gt;= <span class="n">18</span> {
    <span class="k">dasso</span> <span class="s">"Adult"</span>
}
<span class="k">nahi_ta</span> {
    <span class="k">dasso</span> <span class="s">"Minor"</span>
}</pre>
            </article>

            <article>
                <h3><code>jad_tak</code> loops</h3>
                <p>A while loop. Built-in loop protection stops runaway loops.</p>
<pre class="code">i = <span class="n">1</span>
<span class="k">jad_tak</span> i &lt;= <span class="n">5</span> {
    <span class="k">dasso</span> i
    i = i + <span class="n">1</span>
}</pre>
            </article>

            <article>
                <h3><code>kaam</code> / <code>wapas</code></h3>
                <p>Functions take parameters, have their own local scope and can call themselves.</p>
<pre class="code"><span class="k">kaam</span> jod(a, b) {
    <span class="k">wapas</span> a + b
}

<span class="k">dasso</span> jod(<span class="n">10</span>, <span class="n">20</span>)  <span class="c">// 30</span></pre>
            </article>

            <article>
                <h3><code>mang</code> &amp; <code>jawab</code></h3>
                <p>Read the request and set the response. Query values are URL-decoded.</p>
<pre class="code"><span class="c">// khali if the key is missing</span>
naam = mang.GET[<span class="s">"naam"</span>]
<span class="k">dasso</span> mang.method  <span class="c">// GET</span>

jawab.status = <span class="n">200</span>
jawab.type = <span class="s">"application/json"</span></pre>
            </article>
        </div>

        <dl class="ops">
            <div><dt>Arithmetic</dt><dd>+ - * / %</dd></div>
            <div><dt>Comparison</dt><dd>== != &gt; &lt; &gt;= &lt;=</dd></div>
            <div><dt>Logic</dt><dd>&amp;&amp; || !</dd></div>
            <div><dt>Comments</dt><dd>// line &nbsp; /* block */</dd></div>
        </dl>
    </div>
</section>

<section id="live">
    <div class="wrap">
        <span class="eyebrow">Live demo</span>
        <h2>Calculated by Pun for this request</h2>
        <p class="section-intro">Each result on the right was worked out by the interpreter while it rendered this page. The functions <code>jod</code> and <code>factorial</code> are defined in the first block of <code>index.pun</code>.</p>

        <div class="live">
            <div class="live-row">
<pre class="code"><span class="k">dasso</span> jod(<span class="n">10</span>, <span class="n">20</span>)</pre>
                <div class="out"><small>Output</small><b><?pun dasso jod(10, 20) ?></b></div>
            </div>
            <div class="live-row">
<pre class="code"><span class="k">dasso</span> <span class="n">10</span> + <span class="n">20</span> * <span class="n">2</span>  <span class="c">// precedence</span></pre>
                <div class="out"><small>Output</small><b><?pun dasso 10 + 20 * 2 ?></b></div>
            </div>
            <div class="live-row">
<pre class="code"><span class="k">dasso</span> factorial(<span class="n">5</span>)  <span class="c">// recursion</span></pre>
                <div class="out"><small>Output</small><b><?pun dasso factorial(5) ?></b></div>
            </div>
            <div class="live-row">
<pre class="code">i = <span class="n">1</span>
<span class="k">jad_tak</span> i &lt;= <span class="n">5</span> {
    <span class="k">dasso</span> <span class="s">"&lt;span&gt;"</span> + i + <span class="s">"&lt;/span&gt;"</span>
    i = i + <span class="n">1</span>
}</pre>
                <div class="out"><small>Output</small><b class="loop"><?pun
i = 1
jad_tak i <= 5 {
    dasso "<span>" + i + "</span>"
    i = i + 1
}
?></b></div>
            </div>
            <div class="live-row">
<pre class="code"><span class="k">dasso</span> <span class="n">7</span> &gt; <span class="n">3</span> &amp;&amp; !<span class="k">jhooth</span></pre>
                <div class="out"><small>Output</small><b><?pun dasso 7 > 3 && !jhooth ?></b></div>
            </div>
            <div class="live-row">
<pre class="code"><span class="k">dasso</span> mang.method + <span class="s">" "</span> + mang.path</pre>
                <div class="out"><small>Output</small><b><?pun dasso mang.method + " " + mang.path ?></b></div>
            </div>
        </div>
    </div>
</section>

<section id="sample">
    <div class="wrap">
        <span class="eyebrow">Sample site &middot; learn from a working app</span>
        <h2>Pind Dhaba: a dashboard written in Pun</h2>
        <p class="section-intro">
            <code>chowk/sample_site/</code> is a small restaurant dashboard plus a tour that runs every language feature live.
            <code>dashboard.pun</code> pulls in <code>frontend.pun</code>, shows live AJAX updates from <code>backend.pun</code>, and keeps a members list in MySQL through <code>members.pun</code>.
            Open a page in the browser, then read the same file in your editor. Each file starts with a comment that says what it shows.
        </p>

        <div class="sample-links">
            <a class="primary" href="/sample_site/dashboard.pun">Open the dashboard</a>
            <a href="/sample_site/features.pun">Feature tour</a>
            <a href="/sample_site/">Sample home</a>
            <a href="/sample_site/errors.pun">Errors &amp; status codes</a>
        </div>

        <div class="facts sample-files">
            <div class="fact">
                <h3><code>dashboard.pun</code></h3>
                <p>The page shell. Renders the header and a staff picker from a <code>shabdkosh</code> whitelist, then loads <code>assets/app.js</code>.</p>
            </div>
            <div class="fact">
                <h3><code>frontend.pun</code></h3>
                <p>The widgets as an HTML fragment: stat cards, menu, order form, and the MySQL members form. Built with <code>har_ik</code> and <code>jad_tak</code>.</p>
            </div>
            <div class="fact">
                <h3><code>backend.pun</code></h3>
                <p>A JSON API with menu, live stats and orders. Reads <code>mang.GET</code> / <code>mang.POST</code> and replies with <code>jawab.status</code> 200, 400, 405 or 422.</p>
            </div>
            <div class="fact">
                <h3><code>members.example.pun</code></h3>
                <p>MySQL with <code>bhandar()</code>: creates a two-column table, then lists, adds, updates and deletes rows with prepared statements. Copy it to the git-ignored <code>members.pun</code> and add your database details.</p>
            </div>
            <div class="fact">
                <h3><code>assets/app.js</code></h3>
                <p>The browser side: fetches <code>frontend.pun</code> into the page, polls <code>backend.pun</code> every 3 seconds, and posts orders and member changes.</p>
            </div>
            <div class="fact">
                <h3><code>features.pun</code></h3>
                <p>Every feature with its code next to the live output: operators, scope, all collection methods, functions as values, and a <code>print_r</code> helper.</p>
            </div>
            <div class="fact">
                <h3><code>errors.pun</code></h3>
                <p>Triggers Pun's development error page on purpose, links to a 404, and links to each JSON error reply from <code>backend.pun</code>.</p>
            </div>
        </div>

        <div class="tour sample-code">
            <article>
                <div class="explain">
                <h3>The include happens in the browser</h3>
                <p>Pun has no server-side include yet, so <code>dashboard.pun</code> leaves a placeholder and <code>app.js</code> fetches the fragment into it.</p>
                </div>
                <div class="snippet">
                <div class="file"><span>dashboard.pun + assets/app.js, shortened</span><span>HTML + JS</span></div>
<pre class="code"><span class="t">&lt;div</span> id=<span class="s">"frontend"</span>
     data-src=<span class="s">"frontend.pun?from=dashboard"</span><span class="t">&gt;&lt;/div&gt;</span>
<span class="t">&lt;script</span> src=<span class="s">"assets/app.js"</span><span class="t">&gt;&lt;/script&gt;</span>

<span class="c">// assets/app.js</span>
<span class="k">const</span> res = <span class="k">await</span> fetch(host.dataset.src);
host.innerHTML = <span class="k">await</span> res.text();

<span class="c">// then ask backend.pun every 3 seconds</span>
setInterval(poll, <span class="n">3000</span>);</pre>
                </div>
            </article>

            <article>
                <div class="explain">
                <h3>HTML built from a collection</h3>
                <p><code>frontend.pun</code> keeps its stat cards in a <code>soochi</code> of <code>shabdkosh</code> values and prints one card per entry.</p>
                </div>
                <div class="snippet">
                <div class="file"><span>frontend.pun, shortened</span><span>Pun</span></div>
<pre class="code">cards = <span class="k">soochi</span>(
    <span class="k">shabdkosh</span>(<span class="s">"stat"</span>: <span class="s">"orders"</span>, <span class="s">"label"</span>: <span class="s">"Orders today"</span>),
    <span class="k">shabdkosh</span>(<span class="s">"stat"</span>: <span class="s">"queue"</span>,  <span class="s">"label"</span>: <span class="s">"Kitchen queue"</span>)
)

<span class="k">har_ik</span> card <span class="k">vich</span> cards {
    <span class="k">dasso</span> <span class="s">"&lt;article data-stat=\""</span> + card[<span class="s">"stat"</span>] + <span class="s">"\"&gt;"</span>
    <span class="k">dasso</span> <span class="s">"&lt;h3&gt;"</span> + card[<span class="s">"label"</span>] + <span class="s">"&lt;/h3&gt;&lt;/article&gt;"</span>
}</pre>
                </div>
            </article>

            <article>
                <div class="explain">
                <h3>A JSON API in Pun</h3>
                <p><code>backend.pun</code> keeps its handlers in a <code>shabdkosh</code> (functions are values) and sets the status code with <code>jawab</code>.</p>
                </div>
                <div class="snippet">
                <div class="file"><span>backend.pun, shortened</span><span>Pun</span></div>
<pre class="code">jawab.type = <span class="s">"application/json; charset=UTF-8"</span>

<span class="k">kaam</span> stats_dikhao() {
    tick = ank(mang.GET[<span class="s">"tick"</span>], <span class="n">999</span>)
    <span class="k">je</span> tick == <span class="k">khali</span> {
        jawab.status = <span class="n">422</span>
        <span class="k">dasso</span> <span class="s">"{\"ok\": false}"</span>
        <span class="k">wapas</span> <span class="k">khali</span>
    }
    <span class="k">dasso</span> <span class="s">"{\"ok\": true, \"tick\": "</span> + tick + <span class="s">"}"</span>
}

routes = <span class="k">shabdkosh</span>(<span class="s">"stats"</span>: stats_dikhao)
action = mang.GET[<span class="s">"action"</span>]
<span class="k">je</span> action != <span class="k">khali</span> &amp;&amp; routes.hai(action) {
    routes[action]()
}</pre>
                </div>
            </article>

            <article>
                <div class="explain">
                <h3>Reading and writing MySQL</h3>
                <p><code>members.pun</code> opens MySQL with <code>bhandar()</code>, creates its two-column table on first use, and binds every value with <code>mull()</code>, so nothing a visitor types can change the SQL. The connection details live in git-ignored files (<code>.env</code> and <code>members.pun</code>), never in the repo.</p>
                </div>
                <div class="snippet">
                <div class="file"><span>members.example.pun, shortened</span><span>Pun + SQL</span></div>
<pre class="code">db = <span class="k">bhandar</span>(<span class="s">"mysql"</span>, DB_HOST, DB_PORT, DB_NAME, DB_USER, DB_PASS)
db.jodo()

create = db.taiyar(<span class="s">"CREATE TABLE IF NOT EXISTS pun_members ("</span>
    + <span class="s">"naam VARCHAR(100) NOT NULL, email VARCHAR(190) NOT NULL PRIMARY KEY)"</span>)
create.chalao()

insert = db.taiyar(<span class="s">"INSERT INTO pun_members (naam, email) VALUES (?, ?)"</span>)
insert.mull(<span class="n">1</span>, mang.POST[<span class="s">"naam"</span>])
insert.mull(<span class="n">2</span>, mang.POST[<span class="s">"email"</span>])
insert.chalao()

<span class="c">// saare(): every row, as a soochi of shabdkosh</span>
<span class="k">har_ik</span> row <span class="k">vich</span> db.taiyar(<span class="s">"SELECT naam, email FROM pun_members"</span>).saare() {
    <span class="c">// row["naam"], row["email"]</span>
}

db.band()</pre>
                </div>
            </article>
        </div>
    </div>
</section>

<section id="docs">
    <div class="wrap">
        <span class="eyebrow">Documentation</span>
        <h2>Where to read more</h2>
        <p class="section-intro">The Pun docs are Markdown files in the <code>target</code> folder, next to <code>pun-server.jar</code>. Start with the language reference, then pick the guide for what you're doing.</p>

        <div class="docs">
            <article class="doc">
                <span class="tag">Start here &middot; Language reference</span>
                <h3>Pun Scripting</h3>
                <p class="path">target/PUN_SCRIPTING.md</p>
                <p>The complete guide to writing <code>.pun</code> files, from script blocks to the security model. It ends with a one-page quick reference.</p>
                <ul>
                    <li>Script blocks, comments, variables and data types</li>
                    <li>Operators and precedence, string joining</li>
                    <li><code>je</code>/<code>nahi_ta</code>, <code>jad_tak</code>, <code>kaam</code>/<code>wapas</code>, scope</li>
                    <li><code>mang</code> and <code>jawab</code>, full page and form examples</li>
                    <li>Error pages, security model, current limits</li>
                </ul>
            </article>

            <article class="doc">
                <span class="tag">Command line &amp; REPL</span>
                <h3>Pun Scripting CLI</h3>
                <p class="path">target/PUN_SCRIPTING_CLI.md</p>
                <p>How to run Pun from a terminal on Linux, macOS or Windows PowerShell, and how to try statements in the interactive REPL.</p>
                <ul>
                    <li><code>serve</code> for the default <code>chowk</code> folder or a custom one</li>
                    <li><code>--port</code> / <code>-p</code>, and how URLs map to files</li>
                    <li><code>repl</code> with multi-line blocks, <code>:help</code>, <code>:quit</code></li>
                    <li><code>help</code>, <code>version</code>, exit codes 0 / 1 / 2</li>
                </ul>
            </article>

            <article class="doc">
                <span class="tag">Operations</span>
                <h3>Pun Server Management</h3>
                <p class="path">target/PUN_SERVER_MANAGE.md</p>
                <p>Starting, testing and stopping Pun Server, either from the CLI or from the Punjabi Server Manager desktop GUI.</p>
                <ul>
                    <li>Linux and Windows start and stop commands</li>
                    <li>Testing with <code>curl</code> and reaching the server from another machine</li>
                    <li>Step-by-step use of the desktop GUI</li>
                    <li>When to pick the GUI and when to pick the CLI (SSH, Docker, services)</li>
                </ul>
            </article>

            <article class="doc">
                <span class="tag plan">Design doc &middot; not built yet</span>
                <h3>Pun Scripting Server (LSP)</h3>
                <p class="path">target/PUN_SCRIPTING_SERVER.md</p>
                <p>A design for a future Language Server Protocol server that would give editors support for <code>.pun</code> files. It would reuse the existing lexer and parser and would never execute code.</p>
                <ul>
                    <li>Diagnostics, completion, hover, go to definition</li>
                    <li>Document symbols, formatting, semantic tokens</li>
                    <li>Mapping <code>&lt;?pun</code> blocks back to file positions</li>
                    <li>Planned <code>lsp</code> and <code>check</code> commands, tests, open questions</li>
                </ul>
            </article>
        </div>

        <p class="docs-note">
            Also see <code>target/README.md</code> for the project overview: building with Maven, the GUI, CLI and REPL modes, the architecture and the roadmap.
            Pun Server only serves files inside the website folder, so open these docs in your editor or repository browser.
        </p>
    </div>
</section>

<section id="chalao">
    <div class="wrap">
        <span class="eyebrow">Chalao &middot; run it</span>
        <h2>Start a Pun site in one command</h2>
        <div class="run">
            <div>
                <div class="file"><span>terminal</span><span>Java 21+</span></div>
<pre class="code"><span class="c"># serve the chowk folder on port 8080</span>
java -jar target/pun-server.jar serve

<span class="c"># serve your own folder on another port</span>
java -jar target/pun-server.jar serve ./my-site -p <span class="n">9000</span>

<span class="c"># try Pun interactively</span>
java -jar target/pun-server.jar repl

<span class="c"># open the desktop GUI</span>
java -jar target/pun-server.jar</pre>
            </div>
            <ul>
                <li><code>GET /</code> serves <code>index.pun</code> (this page).</li>
                <li><code>GET /form.pun</code> runs <code>form.pun</code>.</li>
                <li><code>GET /sample_site/</code> serves the sample site's <code>index.pun</code>.</li>
                <li>Static <code>.html</code>, <code>.css</code>, <code>.js</code>, <code>.json</code>, <code>.txt</code> and image files are served as they are.</li>
                <li>If <code>chowk</code> doesn't exist, Pun Server creates it next to the folder that holds the JAR.</li>
                <li>Stop the server with <code>Ctrl+C</code>.</li>
            </ul>
        </div>

        <div class="limits">
            <h3>Not in this version yet</h3>
            <p>
                Cookies and sessions, reading <code>.env</code> files, database drivers other than MySQL, imports and modules, JSON request bodies, multipart uploads, and string functions such as converting <code>"7"</code> to <code>7</code> are all on the roadmap.
                There is no HTML-escaping helper yet either, so a value from <code>mang.GET</code> or <code>mang.POST</code> goes into the page exactly as it was sent.
                The <a href="#sample">sample site</a> shows a workaround for each of these.
            </p>
        </div>
    </div>
</section>

</main>

<div class="phulkari" aria-hidden="true"></div>
