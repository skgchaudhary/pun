# MySQL connection details for the Pun sample site.
#
# Copy this file to .env (git-ignored) and fill in your own values.
# Keep .env here in the repo root: Pun Server serves every file inside
# chowk/, so a .env in there could be downloaded by anyone.
#
# Pun scripts can't read .env yet. Copy the same values into
# chowk/sample_site/members.pun (also git-ignored).

DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pun_sample
DB_USER=pun_user
DB_PASS=change-me
